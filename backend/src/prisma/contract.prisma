// use prisma-next

enum user_role {
  ADMIN
  USER
}

enum user_type {
  COMMERCIAL
  PRIVATE
}

model User {
  id               Uuid              @id @default(uuid())
  email            String            @unique
  password_hash    String
  role             user_role         @default(USER)
  user_type        user_type         @default(PRIVATE)
  email_verified   Boolean           @default(false)
  is_suspended     Boolean           @default(false)
  referral_code    String?           @unique
  referred_by_code String?
  created_at       TimestamptzString @default(now())
  updated_at       temporal.updatedAtString()

  private_profile     PrivateProfile?
  company_profile     CompanyProfile?
  subscription        Subscription?
  credit_transactions CreditTransaction[]

  @@map("users")
}

model PrivateProfile {
  id                Int               @id @default(autoincrement())
  user_id           Uuid              @unique
  first_name        String            @default("")
  last_name         String            @default("")
  bio               String?
  location          String?
  profile_image_url String?
  cover_image_url   String?
  created_at        TimestamptzString @default(now())
  updated_at        temporal.updatedAtString()

  user              User              @relation(fields: [user_id], references: [id])

  @@map("private_profiles")
}

model CompanyProfile {
  id                  Int               @id @default(autoincrement())
  user_id             Uuid              @unique
  first_name          String?
  last_name           String?
  company_name        String            @default("")
  bio                 String?
  location            String?
  tier                String            @default("FREE")
  is_strategic_partner Boolean          @default(false)
  company_email       String?
  company_address     String?
  impressum           String?
  privacy_policy_url  String?
  phone               String?
  vat_id              String?
  website_url         String?
  instagram_url       String?
  facebook_url        String?
  logo_url            String?
  cover_image_url     String?
  created_at          TimestamptzString @default(now())
  updated_at          temporal.updatedAtString()

  user                User              @relation(fields: [user_id], references: [id])

  @@map("company_profiles")
}

model Referral {
  id          Int               @id @default(autoincrement())
  referrer_id Uuid
  referred_id Uuid
  status      String            @default("PENDING")
  created_at  TimestamptzString @default(now())

  @@map("referrals")
}

model Plan {
  id            Int               @id @default(autoincrement())
  name          String            @unique
  price_monthly Int               @default(0)
  description   String?
  created_at    TimestamptzString @default(now())

  @@map("plans")
}

model Subscription {
  id                   Int               @id @default(autoincrement())
  user_id              Uuid              @unique
  plan_id              Int
  status               String            @default("ACTIVE")
  current_period_start TimestamptzString
  current_period_end   TimestamptzString
  created_at           TimestamptzString @default(now())
  updated_at           temporal.updatedAtString()

  user                 User              @relation(fields: [user_id], references: [id])

  @@map("subscriptions")
}

model CreditTransaction {
  id          Int               @id @default(autoincrement())
  user_id     Uuid
  amount      Int
  type        String
  description String?
  created_at  TimestamptzString @default(now())

  user        User              @relation(fields: [user_id], references: [id])

  @@map("credit_transactions")
}
